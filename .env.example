# ── GITHUB ──
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=cheuckolate-sketch/creator-campaign-os-backend

# ── OPENAI ──
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ── TELEGRAM ──
TELEGRAM_BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=                        # leave blank first run — script will print your chat ID

# ── CONTROL TOWER SETTINGS ──
POLL_INTERVAL_SECONDS=60                 # how often to check GitHub (default: 60s)
DAILY_OPENAI_CALL_LIMIT=50              # cost guard — max OpenAI calls per day
ENVIRONMENT=production                   # production or development
